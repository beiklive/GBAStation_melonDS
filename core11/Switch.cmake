set(nxbin "$ENV{DEVKITPRO}/tools/bin")
find_program(UAM uam HINTS "${nxbin}" REQUIRED NO_CMAKE_FIND_ROOT_PATH)
find_program(NACP nacptool HINTS "${nxbin}" REQUIRED NO_CMAKE_FIND_ROOT_PATH)
find_program(NRO elf2nro HINTS "${nxbin}" REQUIRED NO_CMAKE_FIND_ROOT_PATH)
set(shaderDir "${CMAKE_CURRENT_BINARY_DIR}/deko_shaders")
file(MAKE_DIRECTORY "${shaderDir}")
foreach(spec wide_vsh:vert wide_fsh:frag wide_fsh:frag:texbuf:WIDE_TEXBUF
             wide_fsh:frag:early:WIDE_EARLY wide_fsh:frag:texbuf_early:WIDE_TEXBUF,WIDE_EARLY
             final_vsh:vert final_fsh:frag)
  string(REPLACE ":" ";" parts "${spec}")
  list(GET parts 0 shader)
  list(GET parts 1 stage)
  set(name "${shader}_dksh")
  set(input "${FULLDEX_SOURCE}/melonDS/src/wide_gpu/${shader}.glsl")
  set(source "${input}")
  set(variant)
  list(LENGTH parts count)
  if(count GREATER 2)
    list(GET parts 2 tag)
    list(GET parts 3 defines)
    set(name "${shader}_${tag}_dksh")
    set(source "${shaderDir}/${name}.glsl")
    set(variant COMMAND "${CMAKE_COMMAND}" "-DIN=${input}" "-DOUT=${source}" "-DDEFINE=${defines}" -P "${FULLDEX_SOURCE}/tools/switch/glsl_define.cmake")
  endif()
  add_custom_command(OUTPUT "${shaderDir}/${name}.h" ${variant}
    COMMAND "${UAM}" -s ${stage} -o "${shaderDir}/${name}.dksh" "${source}"
    COMMAND "${CMAKE_COMMAND}" "-DIN=${shaderDir}/${name}.dksh" "-DOUT=${shaderDir}/${name}.h" "-DNAME=${name}" -P "${FULLDEX_SOURCE}/tools/switch/embed.cmake"
    DEPENDS "${input}" "${FULLDEX_SOURCE}/tools/switch/glsl_define.cmake" "${FULLDEX_SOURCE}/tools/switch/embed.cmake" VERBATIM)
  list(APPEND donorShaders "${shaderDir}/${name}.h")
endforeach()
add_custom_target(core11_shaders DEPENDS ${donorShaders})
add_dependencies(core core11_shaders)
target_sources(core PRIVATE "${FULLDEX_SOURCE}/melonDS/src/GPU3D_WideGpu_Deko.cpp")
target_compile_definitions(core PRIVATE SSR_DEKO3D)
target_include_directories(core PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_link_libraries(session PRIVATE deko3d nx)

set(stub "${GBAS}/nds_stub")
set(sw "${GBAS}/src/frontend/switch")
set(romfs "${CMAKE_BINARY_DIR}/romfs")
file(MAKE_DIRECTORY "${romfs}/shaders")
function(ui_shader stage input name)
  add_custom_command(OUTPUT "${romfs}/shaders/${name}.dksh"
    COMMAND "${UAM}" -s ${stage} -o "${romfs}/shaders/${name}.dksh" "${input}"
    DEPENDS "${input}" VERBATIM)
  set(uiShaders ${uiShaders} "${romfs}/shaders/${name}.dksh" PARENT_SCOPE)
endfunction()
ui_shader(comp "${CMAKE_CURRENT_SOURCE_DIR}/compose.glsl" Core11Compose)
ui_shader(vert "${sw}/Default_vsh.glsl" Default_vsh)
ui_shader(frag "${sw}/Default_fsh.glsl" Default_fsh)
foreach(name NdsDot_fsh NdsDotClear_fsh NdsXbrzFreescale_fsh NdsLcdGridNdsColor_fsh NdsDrasticSimple_fsh)
  ui_shader(frag "${stub}/src/shaders/${name}.glsl" "${name}")
endforeach()
foreach(lang en-US ja-JP zh-CN)
  configure_file("${stub}/resources/lang/${lang}.json" "${romfs}/lang/${lang}.json" COPYONLY)
endforeach()
foreach(asset config/nds_shaders.json material/MaterialIcons-Regular.ttf img/ui/border_gradient.png)
  configure_file("${GBAS}/resources/${asset}" "${romfs}/${asset}" COPYONLY)
endforeach()
file(GLOB sounds "${GBAS}/resources/sounds/switch/*.wav")
foreach(file IN LISTS sounds)
  get_filename_component(name "${file}" NAME)
  configure_file("${file}" "${romfs}/sounds/switch/${name}" COPYONLY)
endforeach()
add_executable(NDS11 Video.cpp "${GBAS}/src/CRC32.cpp" "${sw}/Gfx.cpp" "${sw}/GpuMemHeap.cpp" "${sw}/mm_vec/mm_vec.c" "${sw}/stb_truetype/stb_truetype.c")
foreach(file NdsDekoStubMain NdsDekoRuntime NdsStb NdsCheatDatabase NdsShaderCatalog NdsUiAudio NdsGameLayer NdsMenuLayer ui/UiPrimitives ui/UiComponents)
  target_sources(NDS11 PRIVATE "${stub}/src/${file}.cpp")
endforeach()
target_include_directories(NDS11 PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}" "${stub}/include" "${GBAS}/src" "${GBAS}/external" "${sw}")
target_compile_definitions(NDS11 PRIVATE GBAS_CORE11)
target_link_libraries(NDS11 PRIVATE session core deko3d nx)
add_custom_target(ui_shaders DEPENDS ${uiShaders})
add_dependencies(NDS11 ui_shaders)
add_custom_target(nro ALL
  COMMAND "${NACP}" --create "GBAStation NDS 1.1" "GBAStation" "1.1" "${CMAKE_BINARY_DIR}/NDS11.nacp"
  COMMAND "${NRO}" "$<TARGET_FILE:NDS11>" "${CMAKE_BINARY_DIR}/GBAStationNDS11.nro"
    "--nacp=${CMAKE_BINARY_DIR}/NDS11.nacp" "--icon=${GBAS}/icon/melon_switch.jpg" "--romfsdir=${romfs}"
  DEPENDS NDS11 VERBATIM)
